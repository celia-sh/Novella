{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "exactOptionalPropertyTypes": true,
    "ignoreDeprecations": "6.0",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@novella/reader-layout": [
        "../../packages/reader-layout/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
